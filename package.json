{
  "name": "xenary_store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "test -x ./target/release/xenary_store || cargo leptos build --release; exec ./target/release/xenary_store",
    "start": "./target/release/xenary_store",
    "build": "cargo leptos build --release",
    "lint": "cargo check --all-targets --features ssr && cargo check --lib --target wasm32-unknown-unknown --features hydrate",
    "test": "cargo test --features ssr"
  }
}
