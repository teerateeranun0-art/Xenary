# ============================================================================
# XENARY Store - Environment Configuration Template
# คัดลอกไฟล์นี้เป็น ".env" แล้วกรอกค่าเชื่อมต่อฐานข้อมูลที่ต้องการใช้งาน
# ============================================================================

# --- Runtime & Platform -----------------------------------------------------
PORT="3000"
NODE_ENV="development"

# GEMINI_API_KEY & APP_URL (AI Studio injects these automatically when set)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Admin API Key สำหรับเข้าถึง /api/admin/* ผ่าน header x-admin-key (แนะนำให้เปลี่ยนก่อนใช้งานจริง)
ADMIN_KEY=""

# ============================================================================
# Database Driver Selection
# ============================================================================
# DB_DRIVER: "auto" | "postgres" | "supabase" | "json"
# - "auto" (ค่าเริ่มต้น):
#     1) ถ้ามี DATABASE_URL / POSTGRES_URL / SUPABASE_DB_URL / PGHOST -> ใช้ PostgreSQL
#     2) ถ้ามี SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY -> ใช้ Supabase SDK
#     3) ถ้าไม่ตั้งค่าใดเลย -> ใช้ JSON files ใน src/data/
# - กำหนด "postgres", "supabase", หรือ "json" เพื่อบังคับเลือกใช้เอง
DB_DRIVER="auto"

# ============================================================================
# Option A: PostgreSQL (ใช้ได้ทั้ง PostgreSQL ทั่วไป และ Supabase Postgres URI)
# * ระบบจะสร้างตารางจาก supabase/schema.sql และ Seed ข้อมูลเริ่มต้นให้อัตโนมัติ *
# ============================================================================
# แบบ Connection String (แนะนำสำหรับ Supabase Pooler / Direct, Neon, Railway, RDS)
# ตัวอย่าง Supabase: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# ตัวอย่าง Local:    postgresql://postgres:password@127.0.0.1:5432/xenary
DATABASE_URL=""
# (ทางเลือก: รองรับชื่อ POSTGRES_URL, POSTGRESQL_URL หรือ SUPABASE_DB_URL ด้วย)
# POSTGRES_URL=""
# SUPABASE_DB_URL=""

# หรือแบบแยกตัวแปร (หากไม่ได้ใส่ DATABASE_URL)
PGHOST=""
PGPORT="5432"
PGUSER=""
PGPASSWORD=""
PGDATABASE=""

# การตั้งค่า SSL และ Pool:
# PGSSL: "auto" (ปิด SSL สำหรับ localhost/127.0.0.1 และเปิดให้อัตโนมัติสำหรับ Host ภายนอก) | "true" | "false"
PGSSL="auto"
PG_POOL_MAX="10"

# ============================================================================
# Option B: Supabase Client SDK (REST / PostgREST)
# * กรุณานำไฟล์ supabase/schema.sql ไปรันใน Supabase SQL Editor ก่อนใช้งานครั้งแรก *
# ============================================================================
SUPABASE_URL=""
# ใช้ Service Role Key สำหรับฝั่งเซิร์ฟเวอร์ (บายพาส RLS อย่างปลอดภัย)
SUPABASE_SERVICE_ROLE_KEY=""
# หรือ Anon Key (หากไม่ได้ใช้ Service Role Key)
SUPABASE_ANON_KEY=""
